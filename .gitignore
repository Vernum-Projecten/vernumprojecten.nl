# What Zola writes. The built site is never committed: GitHub Pages serves
# what the workflow built, and a stale public/ in the tree would be a second
# answer to the question of what is live.
/public/
/static/processed_images/

# The local serve cache and the sass map Zola can leave behind.
.zola-cache/
*.css.map

# Editors and IDEs.
.idea/
.vscode/
*.swp
*.swo
*~

# macOS and Windows file managers.
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Scratch: a downloaded tarball, an unpacked binary, a screenshot taken while
# checking a page. None of it belongs in the repository.
/tmp/
*.tar.gz
*.zip
