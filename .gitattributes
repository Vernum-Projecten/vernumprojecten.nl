# Text is stored with LF and checked out with LF on every platform, so a
# checksum a workflow measures is the same one a developer measures.
* text=auto eol=lf

*.woff2 binary
*.ttf binary
*.png binary
*.ico binary
*.jpg binary

# The vendored typeface is not this repository's work: keep it out of the
# language statistics and collapse it in a diff.
assets/fonts/** linguist-vendored

# The house style files are generated by the sibling repository's brand tool
# and are copied in, never hand-edited here.
assets/brand/*.svg linguist-generated
