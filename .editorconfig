# SPDX-License-Identifier: Apache-2.0
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in markdown, so the trim is off.
trim_trailing_whitespace = false
max_line_length = 79

[*.{html,scss,css,toml,yml,yaml,json}]
indent_size = 2

[*.sh]
indent_size = 2

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false

[assets/fonts/**]
# Vendored, kept exactly as published.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
